{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter @flow/db generate && pnpm --filter @flow/contracts build && pnpm --filter @flow/db build",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "../../packages/db/prisma/**",
          "../../packages/contracts/dist/**",
          "../../packages/db/dist/**"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/api/index.ts" }]
}
